# Optional. If Ollama isn't running or the model isn't pulled, the agent runs
# entirely on a deterministic rule-based fallback (see app/interview/fallback.py)
# -- it still conducts a full, adaptive interview and produces structured
# feedback, just without LLM-generated phrasing.
#
# To enable LLM-generated questions:
#   1. Install Ollama: https://ollama.com
#   2. ollama pull llama3.1        (or another chat-capable model)
#   3. ollama serve                (usually already running as a background service)
#
# Fitting note: Day 2 of this cohort's own curriculum ("Local LLM & AI Coding
# Assistant Setup") teaches Ollama + Qwen2.5-Coder -- set OLLAMA_MODEL=qwen2.5-coder
# below if you'd rather reuse that model.

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
